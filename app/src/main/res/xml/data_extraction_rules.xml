<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12+ (API 31+)
    Controls which app data can be extracted by the system
-->
<data-extraction-rules>
    <!-- Allow cloud backup for app data -->
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="cookbook-db" />
        <include domain="file" path="files/" />
    </cloud-backup>
    
    <!-- Allow device transfer -->
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="cookbook-db" />
    </device-transfer>
</data-extraction-rules>
